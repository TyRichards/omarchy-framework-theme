#!/usr/bin/env bash
set -euo pipefail

THEME_NAME="${1:-}"
CURRENT_THEME_DIR="$HOME/.config/omarchy/current/theme"
HERDR_THEME_FILE="$CURRENT_THEME_DIR/herdr.conf"
HERDR_CONFIG="${HERDR_CONFIG_PATH:-$HOME/.config/herdr/config.toml}"

# Scoped to this theme only. Omarchy normalizes repo names like
# omarchy-framework-theme -> framework.
case "$THEME_NAME" in
  framework|framework-theme|omarchy-framework) ;;
  *) exit 0 ;;
esac

[[ -f "$HERDR_THEME_FILE" && -f "$HERDR_CONFIG" ]] || exit 0

python3 - "$HERDR_CONFIG" "$HERDR_THEME_FILE" <<'PY'
import re
import sys
import tomllib
from pathlib import Path

config_path = Path(sys.argv[1])
theme_path = Path(sys.argv[2])
allowed_tokens = {
    "accent", "panel_bg", "surface0", "surface1", "surface_dim", "overlay0",
    "overlay1", "text", "subtext0", "mauve", "green", "yellow", "red",
    "blue", "teal", "peach",
}
theme = tomllib.loads(theme_path.read_text())
colors = {key: value for key, value in theme.items() if key in allowed_tokens and isinstance(value, str)}

config = config_path.read_text()
section = re.search(r"(?m)^\[theme\.custom\][ \t]*$", config)
color_lines = "".join(f'{key} = "{value}"\n' for key, value in colors.items())

if section:
    body_start = section.end()
    next_section = re.search(r"(?m)^\[", config[body_start:])
    body_end = body_start + (next_section.start() if next_section else len(config[body_start:]))
    body = config[body_start:body_end]
    # This theme file is authoritative: remove previously applied tokens that were
    # deleted from herdr.conf instead of leaving stale colors in Herdr's config.
    for key in allowed_tokens:
        body = re.sub(rf"(?m)^[ \t]*{re.escape(key)}[ \t]*=.*(?:\n|$)", "", body)
    config = config[:body_start] + "\n" + color_lines + body.lstrip("\n") + config[body_end:]
else:
    config = config.rstrip() + "\n\n[theme.custom]\n" + color_lines

config_path.write_text(config)
PY

if command -v herdr >/dev/null 2>&1; then
  herdr server reload-config >/dev/null 2>&1 || true
fi
