#!/usr/bin/env bash
set -euo pipefail

THEME_NAME="${1:-}"
CURRENT_THEME_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current/theme"
HERDR_THEME_FILE="$CURRENT_THEME_DIR/herdr.toml"
HERDR_CONFIG="${HERDR_CONFIG_PATH:-$HOME/.config/herdr/config.toml}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-framework-theme"

case "$THEME_NAME" in
  framework|framework-theme|omarchy-framework)
    MODE=apply
    ;;
  *)
    MODE=restore
    ;;
esac

# Unlike tmux, Herdr has no config include/source directive. Keep the user's
# config as the base, add a clearly managed Framework block while this theme is
# active, then restore the displaced values on the next theme change.
[[ -f "$HERDR_CONFIG" ]] || exit 0
if [[ "$MODE" == apply ]]; then
  [[ -f "$HERDR_THEME_FILE" ]] || exit 0
fi

mkdir -p "$STATE_DIR"
exec 9>"$STATE_DIR/herdr-theme.lock"
flock 9

CHANGED=$(python3 - "$MODE" "$HERDR_CONFIG" "$HERDR_THEME_FILE" "$STATE_DIR" <<'PY'
import hashlib
import json
import os
import re
import sys
import tempfile
import tomllib
from pathlib import Path

mode = sys.argv[1]
# Write through the target so an existing dotfiles symlink stays intact and the
# state key remains identical on apply and restore.
config_path = Path(sys.argv[2]).expanduser().resolve()
theme_path = Path(sys.argv[3])
state_dir = Path(sys.argv[4])
# Complete token set from the final Omarchy 3 Framework Herdr profile. Tokens
# outside this set remain untouched while Framework is active.
managed_tokens = {
    "accent", "surface0", "surface_dim", "overlay0", "overlay1", "text",
    "subtext0", "green",
}
start_marker = "# >>> Omarchy Framework Herdr theme (managed)"
end_marker = "# <<< Omarchy Framework Herdr theme (managed)"
section_re = re.compile(r"(?m)^[ \t]*\[theme\.custom\][ \t]*(?:#.*)?$")
token_pattern = "|".join(sorted(map(re.escape, managed_tokens)))
assignment_re = re.compile(
    rf"(?m)^[ \t]*({token_pattern})[ \t]*=.*(?:\n|$)"
)
simple_assignment_re = re.compile(
    rf'^[ \t]*({token_pattern})[ \t]*=[ \t]*"(?:[^"\\]|\\.)*"[ \t]*(?:#.*)?$'
)
marker_re = re.compile(
    rf"(?ms)^[ \t]*{re.escape(start_marker)}[ \t]*\n.*?^[ \t]*{re.escape(end_marker)}[ \t]*(?:\n|$)"
)

config_key = hashlib.sha256(str(config_path).encode()).hexdigest()[:16]
state_path = state_dir / f"herdr-theme-{config_key}.json"


def fail(message):
    raise SystemExit(f"framework-herdr: {message}")


def parse_toml(path, label):
    try:
        return tomllib.loads(path.read_text())
    except (OSError, tomllib.TOMLDecodeError) as error:
        fail(f"cannot read valid {label} at {path}: {error}")


def section_bounds(content):
    match = section_re.search(content)
    if not match:
        return None
    next_section = re.search(r"(?m)^[ \t]*\[", content[match.end():])
    end = match.end() + (next_section.start() if next_section else len(content[match.end():]))
    return match.start(), match.end(), end


def atomic_write(path, content):
    mode_bits = path.stat().st_mode
    with tempfile.NamedTemporaryFile(
        "w", dir=path.parent, prefix=f".{path.name}.", delete=False
    ) as handle:
        handle.write(content)
        temp_path = Path(handle.name)
    os.chmod(temp_path, mode_bits)
    os.replace(temp_path, path)


def save_state(original_lines, section_created, legacy_migration=False):
    state_dir.mkdir(parents=True, exist_ok=True)
    payload = {
        "version": 1,
        "config_path": str(config_path),
        "original_lines": original_lines,
        "section_created": section_created,
        "legacy_migration": legacy_migration,
    }
    with tempfile.NamedTemporaryFile(
        "w", dir=state_dir, prefix=f".{state_path.name}.", delete=False
    ) as handle:
        handle.write(json.dumps(payload, indent=2) + "\n")
        temp_path = Path(handle.name)
    os.replace(temp_path, state_path)


def load_state():
    if not state_path.is_file():
        return None
    try:
        state = json.loads(state_path.read_text())
    except (OSError, json.JSONDecodeError) as error:
        fail(f"cannot read state file {state_path}: {error}")
    if state.get("version") != 1:
        fail(f"unsupported state file version in {state_path}")
    return state


def original_assignments(body):
    matches = list(assignment_re.finditer(body))
    for match in matches:
        if not simple_assignment_re.fullmatch(match.group(0).rstrip("\n")):
            fail(
                f"unsupported {match.group(1)} assignment in [theme.custom]; "
                "use a bare key with a single-line quoted string"
            )

    # A quoted key has the same TOML meaning but cannot be safely restored by
    # the source-preserving line editor. Detect it instead of creating a
    # duplicate semantic key.
    try:
        parsed = tomllib.loads(f"[theme.custom]{body}")
    except tomllib.TOMLDecodeError as error:
        fail(f"cannot safely edit [theme.custom]: {error}")
    semantic_keys = set(parsed.get("theme", {}).get("custom", {})) & managed_tokens
    matched_keys = {match.group(1) for match in matches}
    if semantic_keys != matched_keys:
        unsupported = ", ".join(sorted(semantic_keys - matched_keys)) or "unknown"
        fail(
            f"unsupported assignment syntax for {unsupported} in [theme.custom]; "
            "use bare keys with single-line quoted strings"
        )

    return {
        match.group(1): match.group(0).rstrip("\n")
        for match in matches
    }


content = config_path.read_text()
# Refuse to rewrite malformed user configuration.
config = parse_toml(config_path, "Herdr config")
delete_state = False

if mode == "apply":
    theme = parse_toml(theme_path, "Framework Herdr theme")
    if isinstance(theme.get("theme"), dict):
        custom = theme["theme"].get("custom", {})
    else:
        custom = theme
    colors = {
        key: value
        for key, value in custom.items()
        if key in managed_tokens and isinstance(value, str)
    }
    if not colors:
        fail(f"no supported color tokens found in {theme_path}")

    color_lines = "".join(
        f'{key} = {json.dumps(value)}\n' for key, value in colors.items()
    )
    managed_block = f"{start_marker}\n{color_lines}{end_marker}\n"
    bounds = section_bounds(content)
    state = load_state()

    if bounds:
        _, body_start, body_end = bounds
        body = content[body_start:body_end]
        had_marker = marker_re.search(body) is not None

        outside_managed_block = marker_re.sub("", body)
        original_lines = original_assignments(outside_managed_block)

        if not had_marker and state is None:
            configured_custom = config.get("theme", {}).get("custom", {})
            configured_colors = {
                key: value
                for key, value in configured_custom.items()
                if key in managed_tokens and isinstance(value, str)
            }
            # Upgrade from the legacy hook, which wrote the Framework values
            # without markers or backup state. Those values have no recoverable
            # predecessor, so treat an exact palette match as legacy residue.
            legacy_migration = configured_colors == colors
            if legacy_migration:
                original_lines = {}
            save_state(original_lines, False, legacy_migration)
        elif not had_marker:
            # The old managed block disappeared after state was captured. Treat
            # the current config as the new user-authored baseline rather than
            # letting stale state overwrite it on a later restore.
            save_state(original_lines, False)
        elif state is None:
            # Recover safely if the managed block survived but its state file
            # did not: preserve any user assignments outside that block.
            save_state(original_lines, False)
        else:
            # A newer Framework overlay may manage more tokens than the version
            # that created this state file. Capture newly displaced user values
            # without losing the originals already held for older tokens.
            merged_originals = dict(state.get("original_lines", {}))
            merged_originals.update(original_lines)
            if merged_originals != state.get("original_lines", {}):
                save_state(
                    merged_originals,
                    bool(state.get("section_created")),
                    bool(state.get("legacy_migration")),
                )

        body = marker_re.sub("", body)
        body = assignment_re.sub("", body)
        body = "\n" + managed_block + body.lstrip("\n")
        updated = content[:body_start] + body + content[body_end:]
    else:
        existing_custom = config.get("theme", {}).get("custom")
        if existing_custom is not None:
            fail("[theme.custom] must use a standard table header so it can be restored safely")
        if state is None:
            save_state({}, True)
        separator = "" if not content or content.endswith("\n\n") else ("\n" if content.endswith("\n") else "\n\n")
        updated = f"{content}{separator}[theme.custom]\n{managed_block}"

else:
    state = load_state()
    bounds = section_bounds(content)
    if not bounds:
        original_lines = (state or {}).get("original_lines", {})
        if not original_lines:
            if state_path.exists():
                state_path.unlink()
            print("unchanged")
            raise SystemExit(0)
        if config.get("theme", {}).get("custom") is not None:
            fail("cannot restore saved colors into a nonstandard [theme.custom] table")
        restored = "".join(f"{line}\n" for line in original_lines.values())
        separator = "" if not content or content.endswith("\n\n") else ("\n" if content.endswith("\n") else "\n\n")
        updated = f"{content}{separator}[theme.custom]\n{restored}"
        delete_state = True
    else:
        section_start, body_start, body_end = bounds
        body = content[body_start:body_end]
        had_marker = marker_re.search(body) is not None
        if not had_marker:
            # Without the marker there is no safe proof that Framework still
            # owns these assignments. Keep the current config authoritative and
            # retire stale state instead of deleting newer user values.
            if state_path.exists():
                state_path.unlink()
            print("unchanged")
            raise SystemExit(0)

        body = marker_re.sub("", body)
        if state is not None:
            original_assignments(body)
            body = assignment_re.sub("", body)
        original_lines = (state or {}).get("original_lines", {})
        restored = "".join(f"{line}\n" for line in original_lines.values())
        body = ("\n" + restored + body.lstrip("\n")) if restored else body

        section_created = bool((state or {}).get("section_created"))
        if section_created and not body.strip():
            updated = content[:section_start].rstrip() + "\n" + content[body_end:].lstrip("\n")
        else:
            updated = content[:body_start] + body + content[body_end:]

        delete_state = True

try:
    tomllib.loads(updated)
except tomllib.TOMLDecodeError as error:
    fail(f"refusing to write invalid generated config: {error}")

if updated == content:
    print("unchanged")
else:
    atomic_write(config_path, updated)
    print("changed")

# Keep restoration state until the config replacement has succeeded.
if delete_state and state_path.exists():
    state_path.unlink()
PY
)

if [[ "$CHANGED" == changed ]] && command -v herdr >/dev/null 2>&1; then
  herdr server reload-config >/dev/null 2>&1 || true
fi
